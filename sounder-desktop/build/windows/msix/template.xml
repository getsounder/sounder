<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sounder"
        Arguments=""
        InstallLocation="C:\Program Files\Sounder\Sounder">
    </Installer>
    <PackageInformation
        PackageName="Sounder"
        PackageDisplayName="Sounder"
        PublisherName="CN=Sounder"
        PublisherDisplayName="Sounder"
        Version="0.1.0.0"
        PackageDescription="Sounder desktop agent">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.getsounder.sounder"
                Description="Sounder desktop agent"
                DisplayName="Sounder"
                ExecutableName="sounder"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Sounder</DisplayName>
            <PublisherDisplayName>Sounder</PublisherDisplayName>
            <Description>Sounder desktop agent</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sounder.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
