# 复制为 .env 后按需修改：cp .env.example .env

# Gateway 与 Worker 之间的共享 token（仅本地开发，生产用 mTLS）
SOUNDER_TOKEN=dev-token-please-change

# 模型：provider/model
MODEL=openai/gpt-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MiniMax（PiG 内置 provider：minimax-cn 走 api.minimaxi.com）
MINIMAX_CN_API_KEY=
MINIMAX_API_KEY=

# 本地 Ollama（模型必须支持 tools；llama2 不支持）
# MODEL=ollama/qwen2.5:3b
# OLLAMA_HOST=http://host.docker.internal:11434/v1

# 基础设施
POSTGRES_PASSWORD=sounder
MINIO_USER=sounder
MINIO_PASSWORD=minioadmin

# Worker
WORKER_MAX=4
WORKER_KIND=cloud
WORKER_ID=worker-local-1

# 端口（避免与本机冲突时改这里）
GATEWAY_PORT=9090
WORKER_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 国内网络可改为：https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

SERVER_PORT=8000
WEB_PORT=3000
ADMIN_WEB_PORT=3001

# 用户体系（Phase 1-3）
# 控制面不再支持 legacy token 登录；Web/桌面/移动端统一走账号登录。
# SOUNDER_TOKEN 只用于服务间认证：网关 Bearer、worker 的 -gateway-token。
SOUNDER_AUTH=true
# 本服务（API）对外地址，OAuth 回调前缀必须与 Google/GitHub 控制台一致
SOUNDER_PUBLIC_URL=http://localhost:8000
# Web 前端地址，用于重置密码/邮箱验证跳转
SOUNDER_WEB_URL=http://localhost:3000
# 客户端连网关用的地址，通过 /v1/meta.gatewayUrl 下发（桌面/移动端据此连隧道）
SOUNDER_PUBLIC_GATEWAY=ws://localhost:19090/v1/tunnel
# 设备 worker token 的 HMAC 密钥：服务端签发、网关校验，两边必须一致
SOUNDER_WORKER_SECRET=dev-worker-secret
# 云端设备 provisioner：none（认领网关空闲 Worker）| docker（按配额真正开容器）
SOUNDER_PROVISIONER=docker
SOUNDER_WORKER_IMAGE=ghcr.io/getsounder/sounder-worker:dev
SOUNDER_WORKER_MODEL=minimax-cn/MiniMax-M3
# HTTPS 部署时设为 true
SOUNDER_COOKIE_SECURE=false
SOUNDER_COOKIE_DOMAIN=
SOUNDER_LOCAL_AUTH=true
SOUNDER_REGISTRATION=true
SOUNDER_REQUIRE_EMAIL_VERIFY=false
SOUNDER_NATIVE_REDIRECT=sounder://auth/callback

# Google OIDC：Authorized redirect URI 填 ${SOUNDER_PUBLIC_URL}/v1/auth/oauth/google/callback
SOUNDER_GOOGLE_CLIENT_ID=
SOUNDER_GOOGLE_CLIENT_SECRET=
# GitHub OAuth：Authorization callback URL 填 ${SOUNDER_PUBLIC_URL}/v1/auth/oauth/github/callback
SOUNDER_GITHUB_CLIENT_ID=
SOUNDER_GITHUB_CLIENT_SECRET=
# 本地联调登录（code 输入邮箱即可）；生产保持 false
SOUNDER_DEV_PROVIDER=false

# 邮件（验证/重置密码）。留空则只写日志。
SOUNDER_SMTP_ADDR=
SOUNDER_SMTP_USER=
SOUNDER_SMTP_PASS=
SOUNDER_SMTP_FROM=no-reply@sounder.local
